# AI Assistant - Cloud (API) provider config.
# Copy this file to ".env" and fill AI_CLOUD_KEY. ".env" is gitignored - NEVER commit real keys.
# Cloud is OPTIONAL: Local (the Ollama container) works without any of this.
#
# Default: Ollama Cloud (ollama.com) - big hosted models incl. strong coders
# (qwen3-coder, deepseek, devstral, ...). Get a key: ollama.com -> Keys -> Add API key.
AI_CLOUD_URL=https://ollama.com/v1
AI_CLOUD_KEY=
AI_CLOUD_MODEL=qwen3-coder:480b

# --- Alternative: OpenRouter (most free models) ---
# AI_CLOUD_URL=https://openrouter.ai/api/v1
# AI_CLOUD_KEY=sk-or-...
# AI_CLOUD_MODEL=deepseek/deepseek-chat-v3-0324:free
#
# --- Alternative: Groq (fastest) ---
# AI_CLOUD_URL=https://api.groq.com/openai/v1
# AI_CLOUD_KEY=gsk_...
# AI_CLOUD_MODEL=llama-3.3-70b-versatile
